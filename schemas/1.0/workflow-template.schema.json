{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.dev/schemas/1.0/workflow-template.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "templateId",
    "version",
    "name",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "templateId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^tpl-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "role",
          "affectedPaths"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
          },
          "affectedPaths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "operation"
              ],
              "properties": {
                "operation": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
                },
                "required": {
                  "type": "boolean"
                },
                "acceptableStates": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "accepted",
                      "closed"
                    ]
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            }
          },
          "gates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "gateId",
                "name",
                "phase"
              ],
              "properties": {
                "gateId": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "phase": {
                  "enum": [
                    "pre_dispatch",
                    "pre_acceptance"
                  ]
                },
                "required": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "runBudget": {
            "type": "object",
            "required": [],
            "properties": {
              "inputTokens": {
                "type": "integer",
                "minimum": 0
              },
              "outputTokens": {
                "type": "integer",
                "minimum": 0
              },
              "totalTokens": {
                "type": "integer",
                "minimum": 0
              },
              "costMicros": {
                "type": "integer",
                "minimum": 0
              },
              "elapsedMs": {
                "type": "integer",
                "minimum": 0
              },
              "maxRuns": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false,
            "minProperties": 1
          },
          "retryPolicy": {
            "type": "object",
            "required": [
              "maxAttempts",
              "backoffSeconds"
            ],
            "properties": {
              "maxAttempts": {
                "type": "integer",
                "minimum": 1
              },
              "backoffSeconds": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "additionalProperties": false
          },
          "priority": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "sourceOperation",
          "sourceKind",
          "expectedValue",
          "targetOperation",
          "effect"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
          },
          "sourceOperation": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
          },
          "sourceKind": {
            "enum": [
              "execution",
              "task",
              "gate"
            ]
          },
          "gateId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
          },
          "expectedValue": {
            "enum": [
              "completed",
              "failed",
              "cancelled",
              "accepted",
              "rework",
              "closed",
              "skipped",
              "passed",
              "waived"
            ]
          },
          "targetOperation": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
          },
          "effect": {
            "enum": [
              "activate",
              "skip",
              "block",
              "cancel"
            ]
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "type": "object",
              "properties": {
                "sourceKind": {
                  "const": "execution"
                }
              },
              "required": [
                "sourceKind"
              ]
            },
            "then": {
              "properties": {
                "expectedValue": {
                  "enum": [
                    "completed",
                    "failed",
                    "cancelled"
                  ]
                }
              },
              "not": {
                "required": [
                  "gateId"
                ]
              }
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "sourceKind": {
                  "const": "task"
                }
              },
              "required": [
                "sourceKind"
              ]
            },
            "then": {
              "properties": {
                "expectedValue": {
                  "enum": [
                    "accepted",
                    "rework",
                    "closed",
                    "cancelled",
                    "skipped"
                  ]
                }
              },
              "not": {
                "required": [
                  "gateId"
                ]
              }
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "sourceKind": {
                  "const": "gate"
                }
              },
              "required": [
                "sourceKind"
              ]
            },
            "then": {
              "required": [
                "gateId"
              ],
              "properties": {
                "expectedValue": {
                  "enum": [
                    "passed",
                    "failed",
                    "waived"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
