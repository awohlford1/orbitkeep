{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.dev/schemas/1.0/records/execution.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "record_type",
    "created_at",
    "execution_id",
    "task_id",
    "assignment_id",
    "attempt",
    "state"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "record_type": {
      "const": "execution"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^exe-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^tsk-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "assignment_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^asn-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "run_kind": {
      "enum": [
        "initial",
        "retry",
        "rework"
      ]
    },
    "retry_attempt": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": [
        "ready",
        "running",
        "completed",
        "failed",
        "cancelled",
        "unknown"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "budget": {
      "type": "object",
      "required": [],
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "totalTokens": {
          "type": "integer",
          "minimum": 0
        },
        "costMicros": {
          "type": "integer",
          "minimum": 0
        },
        "elapsedMs": {
          "type": "integer",
          "minimum": 0
        },
        "maxRuns": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "budget_status": {
      "type": "object",
      "required": [
        "state",
        "exceededDimensions",
        "assessedAt"
      ],
      "properties": {
        "state": {
          "enum": [
            "active",
            "exceeded"
          ]
        },
        "exceededDimensions": {
          "type": "array",
          "items": {
            "enum": [
              "inputTokens",
              "outputTokens",
              "totalTokens",
              "costMicros",
              "elapsedMs",
              "maxRuns"
            ]
          },
          "uniqueItems": true
        },
        "assessedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": [
        "inputTokens",
        "outputTokens",
        "cachedInputTokens",
        "costMicros"
      ],
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "cachedInputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "costMicros": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "requested_model": {
      "type": "object",
      "required": [
        "provider",
        "model"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoning_effort": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "actual_model": {
      "type": "object",
      "required": [
        "provider",
        "model"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoning_effort": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "provider_execution_id": {
      "type": "string",
      "minLength": 1
    },
    "result_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    }
  },
  "additionalProperties": false
}
