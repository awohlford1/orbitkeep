{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.dev/schemas/1.0/records/usage-observation.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "record_type",
    "created_at",
    "observation_id",
    "assignment_id",
    "task_id",
    "execution_id",
    "provider",
    "model",
    "measurement",
    "observed_at",
    "input_tokens",
    "output_tokens",
    "cached_input_tokens",
    "cost_micros"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "record_type": {
      "const": "usage-observation"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "assignment_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^asn-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^tsk-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^exe-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "measurement": {
      "enum": [
        "observed",
        "estimated"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "cached_input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "cost_micros": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
