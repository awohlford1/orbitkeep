{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.dev/schemas/1.0/records/silo-capabilities.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "silo_id",
    "silo_instance_id",
    "observed_at",
    "capabilities",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "silo_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^silo-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "silo_instance_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^sinst-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "digest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^sha256:[A-Fa-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
