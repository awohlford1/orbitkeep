{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.dev/schemas/1.0/records/silo-registration-receipt.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "registration_id",
    "registration_version",
    "silo_id",
    "public_key_fingerprint",
    "keep_id",
    "granted_capabilities",
    "charter",
    "status",
    "issued_at",
    "revalidate_at",
    "authority_key_id",
    "idempotency_id",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "registration_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^sreg-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "registration_version": {
      "type": "integer",
      "minimum": 1
    },
    "silo_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^silo-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "public_key_fingerprint": {
      "type": "string",
      "minLength": 1,
      "pattern": "^sha256:[A-Fa-f0-9]{64}$"
    },
    "keep_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^keep-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "colony_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^col-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "granted_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "charter": {
      "type": "object",
      "required": [
        "charter_id",
        "version",
        "digest"
      ],
      "properties": {
        "charter_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^sha256:[A-Fa-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "active",
        "revoked",
        "expired",
        "retired"
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "revalidate_at": {
      "type": "string",
      "format": "date-time"
    },
    "authority_key_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "idempotency_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "signature": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
