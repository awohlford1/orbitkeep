{
  "schemaVersion": "1.0",
  "providers": {
    "claude": { "enabled": true, "requiredMode": "enforced", "captureRawResponses": false },
    "codex": { "enabled": true, "requiredMode": "instructions", "captureRawResponses": false }
  },
  "heartbeat": { "enabled": false, "intervalSeconds": 300 },
  "supervisor": { "idleTimeoutSeconds": 900 },
  "execution": { "retryPolicy": { "maxAttempts": 1, "backoffSeconds": [] } },
  "retention": { "rawResponsesDays": 7, "closedAssignmentsDays": 30, "installationBackupsDays": 30 },
  "integrations": {
    "jira": {
      "enabled": false,
      "mode": "disabled",
      "projectKeys": [],
      "workflowProfiles": [],
      "scrumAgent": {
        "enabled": false,
        "progressComments": true,
        "progressIntervalMinutes": 30,
        "timeTracking": "disabled",
        "estimateUpdates": "propose"
      }
    }
  },
  "silo": {
    "credentialProvider": "none",
    "registration": { "required": false, "trustedAuthorityKeys": {} }
  },
  "security": {
    "executiveApproval": { "mode": "record_only", "trustedPublicKeys": {}, "receiptMaxAgeSeconds": 900 }
  }
}
