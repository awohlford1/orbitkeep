{
  "name": "orbitkeep",
  "version": "0.5.0",
  "license": "MIT",
  "type": "module",
  "description": "Local-first control plane for governed, provider-neutral agent work.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awohlford1/orbitkeep.git"
  },
  "bugs": {
    "url": "https://github.com/awohlford1/orbitkeep/issues"
  },
  "homepage": "https://github.com/awohlford1/orbitkeep#readme",
  "keywords": [
    "orbitkeep",
    "agent-workflow",
    "claude-code",
    "codex",
    "multi-agent",
    "governance"
  ],
  "files": [
    "dist",
    "contracts",
    "defaults",
    "integrations",
    "roles",
    "schemas",
    "templates",
    "docs/domain-model.md",
    "docs/installation.md",
    "docs/product-plan.md",
    "docs/roadmap.md",
    "docs/sdk.md",
    "docs/release-qualification.md",
    "docs/troubleshooting.md",
    "docs/upgrading.md",
    "docs/release.md",
    "README.md",
    "SECURITY.md",
    "SUPPORT.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "bin": {
    "orbitkeep": "dist/cli/index.js",
    "agent-workflow": "dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./contracts": "./dist/contracts/index.js",
    "./config": "./dist/config/index.js",
    "./policy": "./dist/policy/index.js",
    "./commands": "./dist/commands/index.js",
    "./storage": "./dist/storage/index.js",
    "./evidence": "./dist/evidence/index.js",
    "./providers/claude": "./dist/providers/claude/index.js",
    "./providers/codex": "./dist/providers/codex/index.js",
    "./installer": "./dist/installer/index.js",
    "./integrations/jira": "./dist/integrations/jira/index.js",
    "./scheduling": "./dist/scheduling/index.js",
    "./workflows": "./dist/workflows/index.js",
    "./schemas/workflow-template.json": "./schemas/1.0/workflow-template.schema.json",
    "./schemas/relay-envelope.json": "./schemas/1.0/relay-envelope.schema.json",
    "./schemas/charter.json": "./schemas/1.0/charter.schema.json",
    "./templates/software-delivery.json": "./templates/software-delivery.json",
    "./silo": "./dist/silo/index.js",
    "./relay": "./dist/relay/index.js",
    "./defaults/config.json": "./defaults/config.json"
  },
  "scripts": {
    "prepare": "npm run build",
    "prepublishOnly": "npm run release:check",
    "build": "tsc -p tsconfig.build.json",
    "lint": "npm run build && tsc --noEmit",
    "test": "npm run build && node --test tests/**/*.test.ts",
    "test:package": "node scripts/package-smoke.mjs",
    "verify": "npm run roles:check && npm run lint && npm test && npm run test:package && npm run release:artifact",
    "release:artifact": "node scripts/package-policy.mjs",
    "release:check": "npm run verify && node scripts/release-preflight.mjs",
    "test:integration": "node --test tests/integration/*.test.ts",
    "test:conformance": "node --test tests/conformance/*.test.ts",
    "typecheck": "tsc --noEmit",
    "roles:generate": "node src/roles/generate.ts",
    "roles:check": "node src/roles/generate.ts --check"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^5.9.0"
  }
}
